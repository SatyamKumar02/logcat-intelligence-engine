# Copy this file to .env and fill in real values.

# HuggingFace — needed for Qwen2.5 tokenizer/model download
HF_TOKEN=

# WandB — needed for training loss tracking (Phase 4)
WANDB_API_KEY=

# Groq — free tier, used as the 72B distillation teacher (Phase 4)
GROQ_API_KEY=

# Only needed if switching the agent backbone to a paid API instead of Ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama — default agent LLM backbone for Phases 1-3 ($0 cost)
OPENAI_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen2.5:7b
